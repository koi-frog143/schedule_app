                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="@null"
                        android:src="@drawable/todo_checkbox_unchecked" />

                    <TextView
                        android:id="@+id/todo_text_7"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_toEndOf="@id/todo_checkbox_7"
                        android:ellipsize="end"
                        android:fontFamily="sans"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:text="To-do item"
                        android:textColor="#303030"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_alignParentBottom="true"
                        android:background="@drawable/todo_rule_blue"
                        android:contentDescription="@null" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/todo_row_8"
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/todo_checkbox_8"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="@null"
                        android:src="@drawable/todo_checkbox_unchecked" />

                    <TextView
                        android:id="@+id/todo_text_8"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_toEndOf="@id/todo_checkbox_8"
                        android:ellipsize="end"
                        android:fontFamily="sans"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:text="To-do item"
                        android:textColor="#303030"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_alignParentBottom="true"
                        android:background="@drawable/todo_rule_blue"
                        android:contentDescription="@null" />
                </RelativeLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="25dp"
                android:background="@drawable/todo_rule_pink"
                android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
